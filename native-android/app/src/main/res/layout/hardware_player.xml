<?xml version="1.0" encoding="utf-8"?>
<!--
  MediaCodec output through a TextureView: frames are composed by the GPU like the rest of the
  UI instead of going to the TV's video plane. Some TVs (a Candy Google TV) tint that plane
  yellow; dav1d and mpv, which also render through the GPU, look right there.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:use_controller="false"
    app:surface_type="texture_view" />
